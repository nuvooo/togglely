generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  memberships        OrganizationMember[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  createdFlags       FeatureFlag[]        @relation("CreatedFlags")
  updatedFlags       FeatureFlag[]        @relation("UpdatedFlags")
  acceptedInvites    OrganizationInvite[] @relation(name: "AcceptedInvites")
  createdExperiments Experiment[]         @relation("CreatedExperiments")

  @@map("users")
}

model Organization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members      OrganizationMember[]
  projects     Project[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  environments Environment[]
  featureFlags FeatureFlag[]
  invites      OrganizationInvite[]
  experiments  Experiment[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String           @db.ObjectId
  organizationId String           @db.ObjectId
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectType {
  SINGLE
  MULTI
}

model Project {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  key            String
  description    String?
  type           ProjectType @default(SINGLE)
  allowedOrigins String[]    @default([]) // CORS origins allowed for SDK access
  organizationId String      @db.ObjectId
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id])
  environments Environment[]
  featureFlags FeatureFlag[]
  brands       Brand[]
  auditLogs    AuditLog[]
  experiments  Experiment[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("projects")
}

model Brand {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  key         String
  description String?
  projectId   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project          Project           @relation(fields: [projectId], references: [id])
  flagEnvironments FlagEnvironment[]

  @@unique([projectId, key])
  @@index([projectId])
  @@map("brands")
}

model Environment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  key            String
  sortOrder      Int      @default(0)
  projectId      String   @db.ObjectId
  organizationId String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  project          Project           @relation(fields: [projectId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  flagEnvironments FlagEnvironment[]
  experiments      Experiment[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([organizationId])
  @@map("environments")
}

model FeatureFlag {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  key            String
  description    String?
  flagType       FlagType @default(BOOLEAN)
  organizationId String   @db.ObjectId
  projectId      String   @db.ObjectId
  createdById    String   @db.ObjectId
  updatedById    String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id])
  createdBy        User              @relation("CreatedFlags", fields: [createdById], references: [id])
  updatedBy        User?             @relation("UpdatedFlags", fields: [updatedById], references: [id])
  flagEnvironments FlagEnvironment[]
  experiments      Experiment[]
  targetingRules   TargetingRule[]

  @@unique([projectId, key])
  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
  @@map("feature_flags")
}

enum FlagType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

model FlagEnvironment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  flagId        String   @db.ObjectId
  environmentId String   @db.ObjectId
  brandId       String?  @db.ObjectId
  enabled       Boolean  @default(false)
  defaultValue  String   @default("false")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  flag           FeatureFlag     @relation(fields: [flagId], references: [id])
  environment    Environment     @relation(fields: [environmentId], references: [id])
  brand          Brand?          @relation(fields: [brandId], references: [id])
  targetingRules TargetingRule[]

  @@unique([flagId, environmentId, brandId])
  @@index([flagId])
  @@index([environmentId])
  @@index([brandId])
  @@map("flag_environments")
}

model TargetingRule {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  // Rules are flag-wide; environment/brand only scope them (see below)
  flagId               String?      @db.ObjectId
  // Legacy: rules used to belong to one FlagEnvironment row. Only read by
  // the startup migration (flag-wide-rules.migration.ts), then null.
  flagEnvId            String?      @db.ObjectId
  // Scope: empty list = all; *Excluded inverts the list ("none of")
  environmentIds       String[]     @db.ObjectId
  environmentsExcluded Boolean      @default(false)
  brandIds             String[]     @db.ObjectId
  brandsExcluded       Boolean      @default(false)
  name                 String?
  operator             RuleOperator @default(AND)
  serveValue           String
  isDefault            Boolean      @default(false)
  enabled              Boolean      @default(true)
  priority             Int          @default(0)
  // Condition groups: `operator` combines the groups, groupOperators[i]
  // combines the conditions of group i (RuleCondition.groupIndex). Rules
  // without groupOperators are one group combined with `operator`.
  groupOperators       RuleOperator[]
  // Conditions as a tree of AND/OR/NOT blocks (see condition-tree.ts).
  // Older rules have none and use RuleCondition rows + groupOperators.
  conditionTree        Json?
  // Optional time window: the rule applies while activeFrom <= now < activeUntil
  activeFrom           DateTime?
  activeUntil          DateTime?
  // Next window bound not yet announced to SDK clients (RuleScheduleWorker)
  nextBoundaryAt       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  flag            FeatureFlag?     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  flagEnvironment FlagEnvironment? @relation(fields: [flagEnvId], references: [id], onDelete: Cascade)
  conditions      RuleCondition[]

  @@index([flagId])
  @@index([flagEnvId])
  @@index([nextBoundaryAt])
  @@map("targeting_rules")
}

enum RuleOperator {
  AND
  OR
}

model RuleCondition {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  ruleId     String            @db.ObjectId
  attribute  String
  operator   ConditionOperator
  value      String
  // Condition group of the rule (index into groupOperators); null = group 0
  groupIndex Int?
  createdAt  DateTime          @default(now())

  // Relations
  rule TargetingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_conditions")
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  GREATER_THAN
  LESS_THAN
  IN
  NOT_IN
  STARTS_WITH
  ENDS_WITH
  MATCHES_REGEX
}

model ApiKey {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  key            String     @unique
  type           ApiKeyType @default(SERVER)
  organizationId String     @db.ObjectId
  userId         String?    @db.ObjectId
  environmentId  String?
  projectId      String?    @db.ObjectId
  allowedEnvironmentIds String[] @db.ObjectId
  keyHash        String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

enum ApiKeyType {
  SERVER
  CLIENT
  SDK
  MCP
}

model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  action         String
  entityType     String
  entityId       String
  organizationId String   @db.ObjectId
  projectId      String?  @db.ObjectId
  userId         String?  @db.ObjectId
  apiKeyId       String?  @db.ObjectId
  apiKeyName     String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  // Organization log pages: filter by org, newest first.
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model OrganizationInvite {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  // Optional: unbound invites can be used by anyone holding the link
  email          String?
  organizationId String           @db.ObjectId
  role           OrganizationRole @default(MEMBER)
  // SHA-256 of the invite token; the plain token is only shown once.
  // Not @unique: MongoDB unique indexes treat a missing field as null, so
  // legacy invites (no hash) and new invites (no plain token) would collide.
  // Tokens are 256-bit random values, uniqueness is guaranteed by entropy.
  tokenHash      String?
  // Legacy plain token of invites created before hashing was introduced
  token          String?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  createdById    String?          @db.ObjectId
  acceptedAt     DateTime?
  acceptedById   String?          @db.ObjectId
  revokedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation(name: "AcceptedInvites", fields: [acceptedById], references: [id])

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([tokenHash])
  @@index([token])
  @@map("organization_invites")
}

/// Singleton documents guarding one-time instance operations (e.g. setup).
model InstanceLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  createdAt DateTime @default(now())

  @@map("instance_locks")
}

// --- A/B Testing ---

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ExperimentEventType {
  EXPOSURE
  CONVERSION
  CUSTOM
}

model Experiment {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  key            String
  description    String?
  hypothesis     String?
  status         ExperimentStatus @default(DRAFT)
  flagId         String           @db.ObjectId
  environmentId  String           @db.ObjectId
  trafficPercent Int              @default(100)
  startedAt      DateTime?
  endedAt        DateTime?
  createdById    String           @db.ObjectId
  projectId      String           @db.ObjectId
  organizationId String           @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  flag         FeatureFlag         @relation(fields: [flagId], references: [id])
  environment  Environment         @relation(fields: [environmentId], references: [id])
  createdBy    User                @relation("CreatedExperiments", fields: [createdById], references: [id])
  project      Project             @relation(fields: [projectId], references: [id])
  organization Organization        @relation(fields: [organizationId], references: [id])
  variants     ExperimentVariant[]
  events       ExperimentEvent[]

  @@unique([projectId, key])
  @@index([flagId])
  @@index([environmentId])
  @@index([status])
  @@map("experiments")
}

model ExperimentVariant {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  experimentId String   @db.ObjectId
  key          String
  name         String
  description  String?
  value        String
  weight       Int      @default(50)
  isControl    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  experiment Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  events     ExperimentEvent[]

  @@unique([experimentId, key])
  @@index([experimentId])
  @@map("experiment_variants")
}

model ExperimentEvent {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  experimentId String              @db.ObjectId
  variantId    String?             @db.ObjectId
  type         ExperimentEventType
  userId       String
  metadata     Json?
  createdAt    DateTime            @default(now())

  // Relations
  experiment Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    ExperimentVariant? @relation(fields: [variantId], references: [id])

  @@index([experimentId])
  @@index([variantId])
  @@index([experimentId, type])
  @@index([createdAt])
  @@map("experiment_events")
}

// --- Change notifications ---

/// Configuration version per (project, environment). Incremented on every
/// change that can affect SDK evaluation results (ETag / live stream).
model ConfigVersion {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String   @db.ObjectId
  environmentId String   @db.ObjectId
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([projectId, environmentId])
  @@map("config_versions")
}

model Webhook {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId      String    @db.ObjectId
  projectId           String    @db.ObjectId
  url                 String
  secret              String
  /// Empty = all environments of the project
  environmentIds      String[]  @db.ObjectId
  enabled             Boolean   @default(true)
  description         String?
  consecutiveFailures Int       @default(0)
  createdById         String    @db.ObjectId
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastDeliveryAt      DateTime?
  lastStatus          String?

  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  webhookId     String    @db.ObjectId
  eventId       String
  event         Json
  attempt       Int       @default(0)
  /// pending | success | failed
  status        String
  responseCode  Int?
  responseBody  String?
  error         String?
  durationMs    Int?
  nextAttemptAt DateTime?
  lockedUntil   DateTime?
  /// Random token of the worker that currently holds the lock; results are
  /// only written while it still matches (lost locks are not overwritten)
  lockToken     String?
  /// Sent by a user (test event or redeliver): no retries, does not affect
  /// the webhook's failure counter or auto-disable
  manual        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

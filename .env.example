# Backend Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=mongodb://togglely:togglely_secret@localhost:27017/togglely?authSource=admin
REDIS_URL=redis://localhost:6379
# Required, min. 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=7d
RESET_TOKEN_EXPIRY_HOURS=1

# Security
# Bearer token for GET /metrics (Prometheus). Unset = disabled in production.
METRICS_TOKEN=
# Swagger UI at /api/swagger is disabled in production unless set to true
ENABLE_SWAGGER=false
# Demo reset endpoint (POST /api/setup/reset-demo). Demo instances only!
ENABLE_DEMO_RESET=false
# First-run setup (POST /api/setup). When set, the setup form asks for this
# token, so only the operator can claim a fresh instance. Recommended for
# publicly reachable deployments. Generate with: openssl rand -hex 32
SETUP_TOKEN=
# Skip `prisma db push` on container start (schema/index sync). Only set this
# if you sync the schema yourself.
SKIP_DB_PUSH=false
# Per-IP limit for the public /sdk routes
SDK_RATE_LIMIT_PER_MINUTE=600

# Webhooks
# Allow webhook targets in private networks, loopback and link-local ranges
# (SSRF protection). Only enable for receivers in your own trusted network.
WEBHOOK_ALLOW_PRIVATE=false
# Allow plain http:// webhook URLs (default: https only)
WEBHOOK_ALLOW_INSECURE=false
# Disable the webhook delivery worker on this instance (deliveries are queued
# in the database and sent by instances where the worker runs)
WEBHOOK_WORKER_DISABLED=false
# Disable the targeting rule scheduler on this instance (announces time window
# starts/ends of targeting rules to SDK clients; one instance is enough)
RULE_SCHEDULER_DISABLED=false
# Live change stream (GET /sdk/stream/...): max. concurrent streams.
# CLIENT keys (browsers, one stream per tab) and SERVER/SDK keys have separate
# limits. Over the limit clients get 429 and should poll with If-None-Match.
SSE_MAX_PER_CLIENT_KEY=10000
SSE_MAX_PER_CLIENT_IP=50
SSE_MAX_PER_SERVER_KEY=50
SSE_MAX_PER_IP=20

# CORS Configuration (comma-separated list of allowed origins)
# For local development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# For production with separate domains:
# CORS_ORIGINS=https://app.togglely.de,https://togglely.de,https://api.togglely.de

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM="Togglely" <noreply@togglely.com>
SMTP_SECURE=false

# For Production Setup (Coolify):
# Backend gets its own domain: https://api.togglely.de
# Frontend gets its own domain: https://app.togglely.de
# SDK should use BACKEND_URL for direct API access
